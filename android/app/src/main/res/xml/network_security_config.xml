<?xml version="1.0" encoding="utf-8"?>
<!--
  Configurazione di sicurezza di rete (Google Play / hardening) — variante RELEASE.

  Il traffico HTTP in chiaro è bloccato senza eccezioni: l'app parla solo via HTTPS
  con la WebView remota di produzione.

  Il `domain-config` che riapriva il cleartext verso 10.0.2.2 / localhost / 127.0.0.1
  NON sta più qui: è stato spostato in `src/debug/res/xml/network_security_config.xml`,
  che sovrascrive questo file solo nel buildType debug.

  Perché: quegli indirizzi sono irraggiungibili da un telefono reale, quindi la loro
  presenza nell'AAB era innocua nei fatti — ma è esattamente la riga che uno scanner
  automatico segnala, e su Play la dichiarazione «tutti i dati sono cifrati in transito»
  del modulo Sicurezza dei dati va difesa senza asterischi. Tenendola fuori dal bundle
  di produzione, la dichiarazione è vera anche a un'analisi statica del pacchetto.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
