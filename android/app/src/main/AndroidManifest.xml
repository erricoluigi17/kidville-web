<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PRIVACY: nessun backup. Auto Backup copierebbe su Google Drive l'intera
         data dir, compresa `app_webview/Default/` — cioè l'IndexedDB della
         WebView (presenze, diario, armadietto, anagrafiche, galleria offline,
         appello e registro della primaria) e i cookie di sessione. Sono dati
         didattici e sanitari di MINORI in un account che non controlliamo.
         Il dato autorevole è sul server e la sessione è un cookie: dopo un
         ripristino l'utente rifà il login, che qui è il comportamento voluto.
         Servono ENTRAMBI i riferimenti XML: con targetSdk 36 siamo su Android
         12+, dove `allowBackup="false"` chiude il backup su cloud ma NON il
         trasferimento device-to-device (che si chiude solo con
         `<device-transfer>` in data_extraction_rules.xml). `backup_rules.xml`
         copre invece le API ≤ 30. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: schema kidville:// (M10.5) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kidville" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Push FCM: canale di default per le notifiche in background. Senza,
             FirebaseMessaging avvisa "Missing Default Notification Channel
             metadata" e usa un canale di ripiego (titolo/priorità generici). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
