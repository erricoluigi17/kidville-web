<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PRIVACY: nessun backup. Auto Backup copierebbe su Google Drive l'intera
         data dir, compresa `app_webview/Default/` — cioè l'IndexedDB della
         WebView (presenze, diario, armadietto, anagrafiche, galleria offline,
         appello e registro della primaria) e i cookie di sessione. Sono dati
         didattici e sanitari di MINORI in un account che non controlliamo.
         Il dato autorevole è sul server e la sessione è un cookie: dopo un
         ripristino l'utente rifà il login, che qui è il comportamento voluto.
         Servono ENTRAMBI i riferimenti XML: con targetSdk 36 siamo su Android
         12+, dove `allowBackup="false"` chiude il backup su cloud ma NON il
         trasferimento device-to-device (che si chiude solo con
         `<device-transfer>` in data_extraction_rules.xml). `backup_rules.xml`
         copre invece le API ≤ 30. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!--
            windowSoftInputMode: la barra di composizione della chat deve restare a schermo
            quando si apre la tastiera. È il canale con cui le famiglie parlano con la scuola.

            Perché è scritto qui e non lasciato al default (2026-08-02). Il rilievo «la tastiera
            copre il composer» è stato misurato sulla chat VERA — genitore e docente, emulatori
            API 36 e API 33, tastiera confermata da `dumpsys input_method` — e NON si riproduce:
            il viewport si accorcia (innerHeight 731→399 su API 36, 778→499 su API 33,
            `visualViewport.offsetTop` sempre 0) e il bottone «Invia» resta visibile con 12px di
            margine. Nessun rimedio applicativo era quindi giustificato, e non ne è stato aggiunto.

            MA il comportamento misurato dipendeva da un DEFAULT, non da una nostra scelta: senza
            questa riga vale `adjustUnspecified`, e il sistema decide da sé. Sulle versioni provate
            lo risolve in `adjustResize` — su una ROM che lo risolvesse in `adjustPan` la finestra
            verrebbe fatta scorrere invece che ridimensionata, e il composer uscirebbe davvero
            dallo schermo. Dichiararlo è l'unica correzione difendibile: non cambia niente di ciò
            che è stato misurato, e toglie la dipendenza da chi ha compilato la ROM.

            ⚠️ FIN DOVE ARRIVA QUESTA RIGA: Android 14 compreso. Non oltre.
            Da Android 15 le app con targetSdk >= 35 sono edge-to-edge per forza e il sistema
            IGNORA windowSoftInputMode: gli inset dell'IME arrivano alla vista e Chromium
            WebView accorcia da sé il viewport. Questa app dichiara targetSdk 36.
            Misurato il 2026-08-02 compilando un APK GEMELLO con adjustPan e installandolo:
              · API 36 -> numeri IDENTICI all'APK ufficiale (ih 731->399, «Invia» bottom
                695->387, margine 12px). L'attributo e' INERTE.
              · API 33 -> il composer sparisce davvero sotto la tastiera. L'attributo e'
                DECISIVO.
            Quindi: la riga si TIENE (su Android <= 14 e' cio' che regge il composer), ma non
            e' la difesa sui telefoni nuovi. Chi domani vedra' la tastiera coprire la barra su
            un Android 15+ non perda tempo a rileggerla: li' servirebbe gestire gli inset
            (WindowInsetsCompat.Type.ime) o `interactive-widget`, e allora servira' una misura
            con visualViewport.offsetTop != 0 da esibire.
            Il confine e' lockato in __tests__/architecture/tastiera-non-copre-composer.test.ts.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: schema kidville:// (M10.5) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kidville" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Push FCM: canale di default per le notifiche che arrivano ad app chiusa.
             Questa riga DICHIARA solo l'id del canale, NON lo crea: su Android 8+ un
             canale esiste solo se l'app lo registra. Lo crea il JS all'avvio
             (`PushNotifications.createChannel`, id `CANALE_ANDROID_NOTIFICHE` di
             `src/lib/push/canale-android.ts` = `kidville_notifiche`, nome
             «Notifiche Kidville», importanza alta).
             Finché nessuno lo crea, FirebaseMessaging ripiega sul proprio canale
             «Varie» (`fcm_fallback_notification_channel`), con priorità generica.
             L'id qui e quello nel JS devono restare identici. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <!-- Push FCM: icona PICCOLA (barra di stato) e suo colore. Senza, Android usa
             la sagoma dell'icona dell'app, che è una card piena: un quadrato bianco.
             L'icona è la «K» del lettering, bianco su trasparente, generata da
             `node scripts/genera-icona-notifica.mjs`; il colore è il verde del marchio
             (token `color-kidville-green` di globals.css, `kv_green` in colors.xml). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_kidville" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/kv_green" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
